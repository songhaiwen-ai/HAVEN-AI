# ==============================================================================
# HavenResearch Engine 环境变量配置文件 (示例模版)
# 复制此文件并重命名为 .env 即可生效
# ==============================================================================

# 基础应用配置
APP_NAME=HavenResearch Engine
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# 大模型 LLM 配置 (支持 DeepSeek / 阿里通义千问 / OpenAI)
# ------------------------------------------------------------------------------
LLM_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-llm-api-key-here

# ------------------------------------------------------------------------------
# 线上向量数据库配置 (支持 Qdrant Cloud 免费集群 / Chroma 本地)
# ------------------------------------------------------------------------------
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
DEFAULT_COLLECTION_NAME=agent_knowledge_base

# ------------------------------------------------------------------------------
# MySQL 生产级数据库配置 (Docker / Podman 容器内使用 mysql:3306)
# ------------------------------------------------------------------------------
MYSQL_URL=mysql+pymysql://root:your_mysql_password@mysql:3306/haven_agent

# ------------------------------------------------------------------------------
# 实时检索 API Key (Tavily 搜索与 GitHub MCP API)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-key-here
GITHUB_TOKEN=github_pat_your-token-here

# JWT 登录鉴权密钥
JWT_SECRET=your_custom_jwt_secret_key_2026

# Agent 抓取与切片工程参数
MAX_SUBTOPICS=3
SEARCH_MAX_RESULTS=5
SCRAPER_TIMEOUT=10
CHUNK_SIZE=400
CHUNK_OVERLAP=40

# REST API 服务配置
HOST=0.0.0.0
PORT=8000
