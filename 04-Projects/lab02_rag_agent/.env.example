# ==============================================================================
# HavenResearch Engine 环境变量配置文件 (支持 DeepSeek / OpenAI)
# 复制并重命名为 .env 生效
# ==============================================================================

# 基础应用配置
APP_NAME=HavenResearch Engine
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# 大模型配置 示例 A: DeepSeek API (推荐: 极高性价比与强逻辑推理)
# ------------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-api-key-here

# ------------------------------------------------------------------------------
# 大模型配置 示例 B: OpenAI API
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-openai-api-key-here

# 向量数据库配置
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_DIR=./chroma_db
DEFAULT_COLLECTION_NAME=agent_knowledge_base

# Agent 抓取与切片工程参数
MAX_SUBTOPICS=3
SEARCH_MAX_RESULTS=5
SCRAPER_TIMEOUT=10
CHUNK_SIZE=400
CHUNK_OVERLAP=40

# REST API 服务配置
HOST=127.0.0.1
PORT=8000
